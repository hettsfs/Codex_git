data/processed/*
data/external/*
results/figures/*
results/tables/*
results/reports/*

# Preserve placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/reports/.gitkeep
